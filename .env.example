# ====================================================
# 环境变量模板（.env.example）
# 使用方法：复制本文件为 .env 后逐项填写
# 获取方式详见《01-项目启动与操作手册》第三步
# ====================================================

# ============ 数据库（Neon）============
# 从 Neon 后台获取。postgresql:// 开头，不要用 postgres://
DATABASE_URL="postgresql://user:***@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ============ Cloudflare 服务 ============
# R2（文件存储：图片/视频/备份）
R2_ACCOUNT_ID="从 Cloudflare 后台右上角获取"
R2_ACCESS_KEY_ID="从 R2 → API Tokens 获取"
R2_SECRET_ACCESS_KEY="从 R2 → API Tokens 获取"
R2_BUCKET_NAME="yiquantea-assets"
R2_PUBLIC_URL="https://pub-xxx.r2.dev"

# KV（高速缓存：会话/限流计数/B2B token）
KV_NAMESPACE_ID="从 KV 命名空间详情页获取"

# D1（轻量数据库：仅存分析汇总快照）
D1_DATABASE_ID="从 D1 数据库详情页获取"

# ============ JWT 认证 ============
# 生成命令：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="随机生成，至少32位"

# ============ 超级管理员 ============
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="***"

# ============ B2B 展示区密码加密 ============
# 生成命令同上（AES-GCM 加密密钥）
SHOWCASE_PASSWORD_KEY="随机生成，至少32位"

# ============ 邮件发送（Resend）============
RESEND_API_KEY="re_***"

# ============ 网站地址 ============
# 本地开发用 http://localhost:3000，上线改为 https://yiquantea.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ============ hCaptcha（可选，开发阶段可不填）============
NEXT_PUBLIC_HCAPTCHA_SITE_KEY="***"
HCAPTCHA_SECRET_KEY="***"

# ============ 备份保留天数 ============
BACKUP_RETENTION_DAYS=7

# ============ 限流设置 ============
RATE_LIMIT_PUBLIC=60
RATE_LIMIT_LOGIN=5
RATE_LIMIT_B2B=5
